{
  "name": "typing-training",
  "private": true,
  "version": "0.1.24",
  "type": "module",
  "main": "desktop-dist/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "test": "vitest run",
    "desktop:build": "npm run build && esbuild desktop/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=desktop-dist/main.cjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "dist:win": "npm run desktop:build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "kr.gwaze.typingcoach",
    "productName": "AI 타자 코치",
    "artifactName": "AI 타자 코치 Setup ${version}.${ext}",
    "files": [
      "dist/**/*",
      "desktop-dist/main.cjs",
      "desktop/preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
